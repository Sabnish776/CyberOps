# ==============================================================================
# CyberOps Local Environment Secrets Configuration Template
# ------------------------------------------------------------------------------
# To configure local secrets:
# 1. Copy this file to '.env.properties' in backend/ or root directory.
# 2. Update the values with your personal development secrets.
# 3. Note: '.env.properties' is gitignored to protect sensitive credentials.
# ==============================================================================

# JWT Signing Secret (must be at least 256-bit / 32+ characters in production)
JWT_SECRET=S3cur3Cyb3rOpsJwTS3cr3tK3y2026!@#$

# AES-256 Master Key for database credential encryption at rest (must be exactly 32 bytes)
APP_MASTER_KEY=CyberOpsMasterEncKey202632B!

# Optional Database Overrides (defaults to embedded SQLite database)
# SPRING_DATASOURCE_URL=jdbc:sqlite:cyberops.db

# Optional SSH Engine Timeouts (in milliseconds)
# SSH_CONNECT_TIMEOUT_MS=30000
# SSH_CHANNEL_TIMEOUT_MS=30000
# SSH_EXEC_TIMEOUT_MS=30000
# SSH_HEARTBEAT_INTERVAL_MS=15000
